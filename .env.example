# === Cơ sở dữ liệu (mặc định khớp compose.yaml, không cần đổi khi dev) ===
# URL JDBC kết nối PostgreSQL trên máy phát triển.
DB_URL=jdbc:postgresql://localhost:5432/teamwork
# Tên tài khoản PostgreSQL, khớp compose.yaml khi dùng mặc định.
DB_USERNAME=teamwork
# Mật khẩu PostgreSQL dành riêng cho môi trường phát triển.
DB_PASSWORD=teamwork

# Origin frontend được phép gọi API; nhiều origin cách nhau bằng dấu phẩy.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# === JWT ===
# Khóa ký JWT: tạo ngẫu nhiên, tối thiểu 32 byte, không dùng mật khẩu dễ đoán.
JWT_SECRET=

# === Cloudflare R2 (lưu trữ tệp) ===
# Lấy từ Cloudflare Dashboard > R2 > Overview (Account ID) và Manage API Tokens
# Mã tài khoản Cloudflare sở hữu bucket.
R2_ACCOUNT_ID=
# Access Key ID của token chỉ được cấp quyền trên bucket phát triển.
R2_ACCESS_KEY_ID=
# Secret Access Key đi kèm; chỉ chia sẻ qua kênh nội bộ.
R2_SECRET_ACCESS_KEY=
# Tên bucket lưu tệp của môi trường phát triển.
R2_BUCKET=

# === Dịch vụ AI (tóm tắt nội dung) ===
# Nhóm dùng Google AI Studio (Gemini); lấy key tại https://aistudio.google.com/
# API key Google AI Studio của môi trường phát triển.
AI_API_KEY=
# Model Flash thay thế Gemini 2.0 Flash theo lịch ngừng hỗ trợ của Google.
# https://ai.google.dev/gemini-api/docs/deprecations
AI_MODEL=gemini-3.6-flash

# === Email (SMTP) ===
# Ví dụ Gmail: bật 2FA rồi tạo App Password tại myaccount.google.com > Bảo mật
# Máy chủ SMTP gửi email.
MAIL_HOST=smtp.gmail.com
# Cổng SMTP dành cho STARTTLS.
MAIL_PORT=587
# Địa chỉ email đăng nhập SMTP.
MAIL_USERNAME=
# App Password của Gmail; không dùng mật khẩu đăng nhập tài khoản.
MAIL_PASSWORD=
